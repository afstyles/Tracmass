&INIT_GRID_DESCRIPTION
        ! Direction of the grid (1 - E->W, S->N, B->U)
        griddir = 1,1,-1

        ! Does the netcdf data start with a zero index?
        zeroindx = .TRUE.

        ! Describe filenames
        physDataDir    = '/gws/nopw/j04/bas_pog/astyles/DRAKKAR_SET/5day/',           ! directory of physical data (u,v,T,S,MLD,etc) +++DATADIR+++
        physPrefixForm = 'ORCA025-N06_',
        dateformat     = 'YYYYMMDD',
        tGridName      = 'd05T',                           ! name of Tgrid, e.g. grid_T
        uGridName      = 'd05U',                           ! name of Ugrid
        vGridName      = 'd05V',                           ! name of Vgrid                ! suffix of files, e.g. ".nc"

        fileSuffix     = '.nc',

        ! Describe variable names
        hs_name        = 'zos',                     ! Sea surface height
        ueul_name      = 'uo',                    ! name of resolved zonal velocity
        veul_name      = 'vo',                    ! ---- " -------   meridional
        usgs_name      = '',                    ! name of eddy induced zonal velocity
        vsgs_name      = '',                    ! ---- " -------   meridional
/

&INIT_GRID_SIZE
     	! Size of global grid
     	imt            = 1440,                             ! number of global i points
     	jmt            = 1021,                             ! number of global j points
     	km             = 75,                              ! number of global k points

      iperio  = 1                                       ! zonal periodic
      jperio  = 1                                       ! meridional boundary conditions

      topoDataDir    = '/gws/nopw/j04/bas_pog/astyles/DRAKKAR_SET/topo/',               ! directory of grid data

      hgridFile      = 'mesh_hgr.nc'      ! file with dx, dy etc
      dy_name        = 'e2t'                            ! name of dy at T point
      dyu_name       = 'e2u'                            !         dy at U point
      dx_name        = 'e1t'                            ! name of dx at T point
      dxv_name       = 'e1v'                            !         dx at V point

      zgridFile      = 'mesh_zgr.nc'                    ! file with dz etc.
      dzt_name       = 'e3t_0'                          ! name of 3D dz at T point
      dzu_name       = 'e3u_0'                          ! --- " ---  dz at U point
      dzv_name       = 'e3v_0'                          ! --- " ---  dz at V point

      bathyFile      = 'mesh_zgr.nc'                 ! file with bathymetry in model levels
      kmt_name       = 'mbathy'                    ! name of bathymetry in model levels

/

&INIT_GRID_SUBDOMAIN
     l_subdom    = .TRUE.                              ! Initialise subdomain
     imindom     = 1                                   ! Eastern and western wall for subdomain
     imaxdom     = 1440
     jmindom     = 1                                   ! Southern and northern wall for subdomain
     jmaxdom     = 400
/

&INIT_GRID_TIME
     ngcm_step      = 5,                                ! time between two time levels
                                                        ! if ncgcm_unit = 5, then ngcm_step = 3 means 3 months
     ngcm_unit      = 4,                                ! units of ngcm (1=seconds, 2=minutes, 3=hours, 4=days, 5=months, 6=years)
                                                        !
     iter           = 100,                              ! number of subcycles between time levels                                                             ! stopped
     single_tcount  = .TRUE.,                                ! Only a single time index per file (typical for uncombined data)
/

&INIT_START_DATE
     startsec       = 0,                                ! start time
     startmin       = 0,
     starthour      = 0,
     startday       = 16,                              ! start date
     startmon       = 12,
     startyear      = 2012,
     noleap         = .TRUE.,                          ! don't use leap years?
     mon30day       = .FALSE.,
/

&INIT_RUN_TIME
     ! Loop run
     loopYears      = .FALSE.,				   ! make a time loop to run
     		      					               ! e.g. 30 years using only 1 year of data
     loopStartYear  = 2000,				     ! year to start loop from
     loopEndYear    = 2001,				     ! last year of loop

     ! Verbose
     log_level    = 1

     ! Information of run time
     intrun         = 2190          ! number of time steps for run (2190 for 30 years with 5 day data)
/

&INIT_WRITE_TRAJ
     write_frec    = 5     ! 1 = write at time intervals of gcm datasets (each ints)
                           ! 2 = write at each time iteration
                           ! 3 = write each spatial grid-crossing
                           ! 4 = write all the time steps
                           ! 5 = write only start and end positions


     outDataDir    = '/work/scratch-nopw2/afstyles/ORCA025/OUTPUT/+++OUTDIR+++/',
     outDataFile = 'TRACMASS_ORCA025_+++LABEL+++',

     timeformat    = 0     ! Format of the time array
                           ! 0 - tt / 1 - ts / 2 - YYYY, MM, DD, HH
/

&INIT_SEEDING
      nff            = -1,          ! = 1 run forward trajectories
          		      					     ! = -1 run backwards
      isec           = 1,				   ! = 1 start on zonal cell wall
          		      					     ! = 2 start on meridional cell wall
     							                 ! = 3 start on vertical wall
      idir           = 1, 				 ! = 1 start only when flux > 0
          		      					     ! = -1      only when flux < 0
      nqua           = 3,					 ! number of trajectories can be set by
     														   ! = 1 constant number of particles in all seeding cells
     														   !     set by partQuant (particles / gridcell)
     														   ! = 2 Each particle reflects mass transport at seeding.
     														   !     set by partQuant (m3/s or kg/s per particle)
     														   ! = 3 Each particle reflects air/water mass/volume at seeding.
     														   !     set by partQuant in m3 or kg per particle
      !Fixed volume = 5km x 5km x 40m = 1e9
      partquant      = 1e9,                      ! particles/gridcell or m3s-1/particle or m3/particle
      loneparticle   = 0, 				 ! start only one trajectory for debugging
      seedtype       = 3,				   ! = 1 seed using ist,jst,kst (below)
                					     ! = 2 seed using file with start positions
                                               ! = 3 subsampled seed using file with start positions
      nsdPerCellAvg  = 15,                        ! If nqua=2 or 3 -> Expected average number of trajectories per cell (don't factor in time) 
                                                 !                   In original TRACMASS this is assumed to be 10,000 which
                                                 !                   is a bit high...

     	! when seedtype = 1,
      ist1           = 1,                                 !
      ist2           = 1440,                                 !
      jst1           = 1, 				    ! 			                k = [kst1,kst2]
      jst2           = 398,
      kst1           = 1,
      kst2           = 75,
      ! when seedtype = 2 or 3
      seeddir        = '/gws/nopw/j04/bas_pog/astyles/DRAKKAR_SET/seeding/seeding_subsampled_3x398/',     ! directory for seed files +++SEEDDIR+++
      seedfile       = '+++SEEDFILE+++',				     ! name of seed file
      
      ! when seedtype = 3
      subsamplefile  = '+++SUBSAMPLEFILE+++',
      subsamplerate = 0.05,

      seedtime       =  2,		   ! = 1 seed only for specific times
                                       ! = 2 seed using file with start positions

      ! when seedtime = 1
      tst1           = 1,				       ! seed only between tst1 and tst2
      tst2           = 12,

      ! when seedtime = 2
      timefile       = 'ORCA_timefile_20ydecember.csv',             ! name of seed file
/

&INIT_TRACERS
      l_tracers = .TRUE.               ! Should we evaluate tracers along the trajectories?

      ! Tracer name (description)
      tracername = 'To','S','sigma0_teos','sigma10diff'
      ! Tracer unit (description)
      tracerunit = 'degC','g/kg','kg/m3','kg/m3'

      ! Name of the variable in the netcdf (if it's read)
      tracervarname = 'thetao','so','',''

      ! Action (read or compute)
      traceraction = 'read','read','compute','compute'

      ! Minimum and maximum value of the binning
      tracermin = -3, 32, 20, -10
      tracermax = 33, 38, 30,  10

      ! Dimension of the tracer
      tracerdimension = 3D, 3D, 3D, 3D
/

&INIT_TRACERS_SEEDING
      ! minimum and maximum value for seeding
      ! same order as in tracername
      !tracer0min = 2, 34.9,
      !tracer0max = 4, 35.0,

      !Only seed particles that are below our definition of the mixed layer
      tracer0min  = -9999, -9999, -9999, 0.01
      tracer0max  =  9999,  9999,  9999, 9999 
/

&INIT_KILLZONES
      timax = 75000 ! time limit for traj [days]

      exitType = 2
      ! If exitType = 1: killing zone defined by a box
      ! IMPORTANT -> The maximum number of boxes than can be defined are 10
      ! ienw,iene are western and eastern i indices of killzone
      ! jens,jenn are southern and northern j indices of killzone
      ! ienw =   0,  500,
      ! iene = 100, 1000,
      ! jens = 200,  450,
      ! jenn = 300,  470,
      ! sets up two killzones, the first i = [0,100], j = [200,300]
      ! the other i = [500,1000], j = [450,470]
      ienw           =  1,	  ! west indices of killzones
      iene           =  2,     ! east indices of killzones
      jens           =  600,      ! south indices of killzones
      jenn           =  601,    ! north indices of killzones

      ! If exitType = 2: killing zone defined by tracer value
      ! Tracerchoice defines which tracer is used for the killing zone
      ! it could be different
      !tracerchoice = 1, 2
      !tracere      = 25, 35
      !maxormin     =  1, -1
      ! This set up defines a killing zone by the 25C isotherm (maximum)
      ! and the 35psu isohaline (minimum)

      !Eliminate trajectories that touch the bottom of the mixed layer
      tracerchoice = 4
      tracere      = 0.01
      maxormin     = -1

/

&INIT_POSTPROCESS
      l_psi      = .FALSE.          ! Compute stream Functions
      dirpsi     = -1,-1,-1,-1,-1  ! Direction of integration
/

&INIT_ACTIVE

/
